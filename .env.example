# ================================================================
# DLH Kabupaten Lumajang - Retribusi Sampah Backend Environment
# ================================================================

PORT=3001

# --- Database Configuration (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=erestribusi_db

# --- Authentication & Security ---
# Generate a strong 256-bit random string for production
JWT_SECRET=your_strong_jwt_secret_key_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dev.dlh.lumajangkab.go.id,https://erestribusi.lumajangkab.go.id

# --- Elasticsearch Search Node (Optional, fallback to DB if empty) ---
ELASTICSEARCH_NODE=

# --- ASPI SNAP Payment Gateway Configurations ---
# Production / Sandbox ASPI Base URL (e.g., https://apidevportal.aspi-indonesia.or.id or Bank Jatim live host)
SNAP_BASE_URL=https://apidevportal.aspi-indonesia.or.id
SNAP_CLIENT_KEY=your_aspi_client_key
SNAP_CLIENT_SECRET=your_aspi_client_secret
SNAP_PARTNER_SERVICE_ID=88888
SNAP_MERCHANT_ID=DLH_LUMAJANG_01

# RSA Keys (format with \n for multiline or raw single-line secret)
SNAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SNAP_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# SNAP Flags: set to true for local testing without active bank connection
SNAP_MOCK_MODE=false
SNAP_VERIFY_SIGNATURE=true
